<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

  
    <module name="TreeWalker">

        <module name="SuppressionXpathFilter">
            <property name="file" value="suppressions.xml"/>
        </module>

        <!-- ===== High ROI: things the compiler can't catch ===== -->

        <!-- Equals/hashCode contract consistency -->
        <module name="EqualsHashCode"/>
        <module name="EqualsAvoidNull"/>

        <!-- Exception handling: catch empty/overly-broad catch blocks -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="IllegalCatch">
            <property name="illegalClassNames"
                      value="java.lang.Exception, java.lang.Throwable, java.lang.RuntimeException"/>
        </module>

        <!-- Cyclomatic complexity — flag methods above a reasonable threshold -->
        <module name="CyclomaticComplexity">
            <property name="max" value="12"/>
        </module>

        <!-- Missing switch default — a real logic-gap catcher -->
        <module name="MissingSwitchDefault"/>

        <!-- ===== Dead code / real-mistake detectors ===== -->

        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>

        <!-- Unused local variables (via UnusedLocalVariable, Checkstyle 10.12+) -->
        <module name="UnusedLocalVariable"/>

        <!-- ===== Medium ROI: structural / maintainability ===== -->

        <!-- Method and class length limits, loosely correlated with complexity -->
        <module name="MethodLength">
            <property name="max" value="60"/>
        </module>
        <module name="ClassDataAbstractionCoupling">
            <property name="max" value="10"/>
        </module>

        <!-- Braces — cheap, prevents dangling-else style bugs -->
        <module name="NeedBraces"/>

        <!-- ===== Cheap consistency, kept since near-zero cost ===== -->

        <module name="WhitespaceAround">
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
        </module>
        <module name="MethodParamPad"/>
        <module name="NoWhitespaceBefore"/>

    </module>

</module>